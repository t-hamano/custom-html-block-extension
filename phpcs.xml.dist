<?xml version="1.0"?>
<ruleset name="Custom HTML Block Extension Coding Standards">
	<description>A custom set of coding standard rules for the Custom HTML Block Extension plugin.</description>
	<file>.</file>
	<rule ref="WordPress">
		<exclude name="WordPress-Docs" />
	</rule>
	<rule ref="PHPCompatibilityWP" />
	<config name="testVersion" value="8.2-" />
	<config name="minimum_wp_version" value="7.1" />
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="custom-html-block-extension" />
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="custom_html_block_extension" />
			</property>
		</properties>
	</rule>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>
	<exclude-pattern>*/*.js</exclude-pattern>
	<exclude-pattern>*/*.css</exclude-pattern>
</ruleset>

{
	"name": "t-hamano/custom-html-block-extension",
	"description": "Extend Custom HTML block to evolve into the advanced code editor.",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Aki Hamano"
		}
	],
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"squizlabs/php_codesniffer": "*",
		"wp-coding-standards/wpcs": "^3.4",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"lint": "phpcs ./ --standard=./phpcs.ruleset.xml"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2"
		}
	}
}

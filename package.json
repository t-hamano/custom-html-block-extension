{
	"name": "custom-html-block-extension",
	"version": "4.1.0",
	"description": "WordPress plugin to extends \"Custom HTML block\" to evolve into an advanced code editor",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gutenberg",
		"block",
		"html",
		"highlighting",
		"emmet"
	],
	"homepage": "https://github.com/t-hamano/custom-html-block-extension",
	"repository": "git+https://github.com/t-hamano/custom-html-block-extension.git",
	"bugs": {
		"url": "https://github.com/t-hamano/custom-html-block-extension/issues"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"files": [
		"assets",
		"classes",
		"src",
		"build",
		"custom-html-block-extension.php",
		"uninstall.php",
		"readme.txt"
	],
	"dependencies": {
		"@wordpress/icons": "^19.0.0",
		"@wordpress/ui": "0.25.0",
		"emmet-monaco-es": "^5.7.0",
		"jsonc-parser": "3.3.1",
		"monaco-editor": "0.57.0"
	},
	"devDependencies": {
		"@types/wordpress__block-editor": "^15.0.8",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/base-styles": "14.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/keycodes": "^5.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/primitives": "^5.0.0",
		"@wordpress/private-apis": "^3.0.0",
		"@wordpress/scripts": "^37.0.0",
		"clsx": "2.1.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"husky": "^9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"scripts": {
		"wp-env": "wp-env",
		"wp-env-test": "wp-env --config .wp-env.test.json",
		"start": "npm run clean && npm run build:monaco && wp-scripts start src/admin src/block-editor src/classic-editor src/theme-plugin-editor --output-path build",
		"build": "npm run clean && wp-scripts build src/admin src/block-editor src/classic-editor src/theme-plugin-editor --output-path build && npm run build:monaco",
		"build:monaco": "wp-scripts build --config webpack.monaco.config.js",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"clean": "rimraf build",
		"check-licenses": "wp-scripts check-licenses",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:types && npm run lint:php && npm run lint:md-docs && npm run lint:pkg-json",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:types": "tsc",
		"lint:php": "vendor/bin/phpcs",
		"lint:md-docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json",
		"test:e2e:debug": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json --debug",
		"test:php": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/custom-html-block-extension vendor/bin/phpunit",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,yml,yaml}": [
			"wp-scripts format"
		],
		"*.{js,ts,tsx}": [
			"wp-scripts lint-js"
		],
		"*.scss": [
			"wp-scripts lint-style"
		],
		"*.md": [
			"wp-scripts lint-md-docs"
		],
		"package.json": [
			"wp-scripts lint-pkg-json"
		]
	}
}
